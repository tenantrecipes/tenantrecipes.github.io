{
 "id": "license-inventory-script",
 "status": "published",
 "order": 350,
 "category": "Licensing & reporting",
 "title": "List who has which license with Graph PowerShell",
 "problem": "You need a quick inventory of license assignments for cost review.",
 "steps": [
  "`Connect-MgGraph -Scopes 'User.Read.All','Organization.Read.All'`",
  "`$skus = Get-MgSubscribedSku | Select SkuId, SkuPartNumber, ConsumedUnits, @{n='Enabled';e={$_.PrepaidUnits.Enabled}}`",
  "`Get-MgUser -All -Property DisplayName,UserPrincipalName,AssignedLicenses | Select DisplayName,UserPrincipalName,@{n='Skus';e={($_.AssignedLicenses.SkuId | % { $id=$_; ($skus | ? SkuId -eq $id).SkuPartNumber }) -join ';'}} | Export-Csv licenses.csv -NoTypeInformation`"
 ],
 "pitfalls": [
  "Use -All, otherwise only the first page is returned."
 ],
 "done_when": [
  "licenses.csv contains every user with their SKU part numbers.",
  "SKU totals (enabled vs consumed) have been reviewed for unused licenses."
 ],
 "sources": [
